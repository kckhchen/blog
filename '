{%- assign is_post = page.layout == 'post' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://kckhchen.com/#person",
      "name": {{ site.author.name | jsonify }},
      "url": "https://kckhchen.com/",
      "sameAs": [
        "https://github.com/kckhchen"
      ],
      "knowsAbout": ["Python", "Jekyll", "Obsidian", "Ruby", "GitHub", "SaaS"]
    }
    {%- if is_post %},
    {
      "@type": "BreadcrumbList",
      "@id": "{{ page.url | absolute_url }}#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "首頁", "item": "https://kckhchen.com/" },
        { "@type": "ListItem", "position": 2, "name": "Blog", "item": "{{ '/' | absolute_url }}" },
        { "@type": "ListItem", "position": 3, "name": {{ page.title | jsonify }} }
      ]
    }
    {%- endif %}
  ]
}
</script>
